{
  "type": "module",
  "name": "full-stack-starter-server",
  "version": "7.0.0",
  "main": "app.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "dev": "prisma migrate deploy; prisma db push --accept-data-loss; npm run prisma:generate; fastify start -w -l info -P app.js",
    "lint": "eslint --fix",
    "lint:check": "eslint",
    "pretest": "eslint",
    "prisma:generate": "prisma generate; tsc",
    "prisma:studio": "prisma studio",
    "start": "fastify start -l info app.js",
    "test": "node --test-concurrency 1 --test $(find test -name '*.test.js')",
    "tsc:watch": "tsc --watch --preserveWatchOutput"
  },
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1138.0",
    "@aws-sdk/cloudfront-signer": "^3.1138.0",
    "@aws-sdk/s3-request-presigner": "^3.1138.0",
    "@fastify/autoload": "^6.5.0",
    "@fastify/secure-session": "^8.4.0",
    "@fastify/static": "^10.1.4",
    "@fastify/swagger": "^9.9.0",
    "@fastify/url-data": "^6.0.4",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@scalar/fastify-api-reference": "^1.71.0",
    "accepts": "^1.3.8",
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.3",
    "ejs": "^6.0.1",
    "email-templates": "^13.0.1",
    "es-toolkit": "^1.52.0",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "fastify-zod-openapi": "^5.7.0",
    "http-status-codes": "^2.3.0",
    "inflection": "^3.0.2",
    "luxon": "^3.7.2",
    "mime-types": "^3.0.2",
    "nodemailer": "^8.0.4",
    "pm2": "^6.0.14",
    "zod": "^4.6.5",
    "zod-openapi": "^6.0.2"
  },
  "devDependencies": {
    "@sfcivictech/prisma-fixtures": "^1.0.0",
    "@testcontainers/postgresql": "^12.1.0",
    "c8": "^12.0.0",
    "eslint": "^9.39.5",
    "fastify-cli": "^8.0.2",
    "neostandard": "^0.13.0",
    "nodemailer-mock": "^2.1.0",
    "prisma": "^7.10.0",
    "testcontainers": "^12.1.0",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  },
  "imports": {
    "#lib/*.js": "./lib/*.js",
    "#models/*.js": "./models/*.js",
    "#prisma/*.js": "./prisma/*.js",
    "#test/*.js": "./test/*.js"
  }
}